# Copy this file to .env and adjust as needed. .env itself is
# gitignored — never commit real values, and never commit the actual
# image files either (see SAMPLE_IMAGES_DIR below).

# --- Postgres ---
POSTGRES_USER=jobs_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=jobs
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://jobs_app:change_me@postgres:5432/jobs

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=jobs_app
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_URL=amqp://jobs_app:change_me@rabbitmq:5672/
RABBITMQ_PORT=5672

# --- Images ---
# Host-side folder to bind-mount into api/worker containers. The
# sample images are NOT pushed to git (see .gitignore) — zip
# sample_images/ separately and hand it out; whoever receives it just
# unzips it wherever they like and points this at that path (relative
# to this file, or an absolute path — either works).
SAMPLE_IMAGES_DIR=./sample_images
# Container-internal path the app actually reads from — leave this one
# alone unless you also change the volume mapping in docker-compose.yml.
IMAGE_BASE_DIR=/app/sample_images

# --- Blur detection (DESIGN.md) ---
BLUR_THRESHOLD=100.0

# --- Reconciler (DESIGN.md §5) ---
PROCESSING_TIMEOUT_SECONDS=120
RECONCILER_INTERVAL_SECONDS=5

# --- Retries (DESIGN.md §6) ---
MAX_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=2.0

# --- API ---
API_PORT=8000
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- RabbitMQ management UI (dev-only — EDGECASE.md 4.6, don't expose this outside local dev) ---
RABBITMQ_MANAGEMENT_PORT=15672
